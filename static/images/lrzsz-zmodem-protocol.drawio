          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="ZDATA(offset N) + streaming data subpackets" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4382;entryX=0.5;entryY=0.4382;" edge="1" parent="1" source="sender" target="receiver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="Receiver detects bad CRC or a missing range" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="810" y="460" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="ZRPOS: retransmit from last verified offset M" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5618;entryX=0.5;entryY=0.5618;" edge="1" parent="1" source="receiver" target="sender">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
