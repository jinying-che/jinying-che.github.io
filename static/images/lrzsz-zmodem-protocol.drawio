          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="ZEOF: final byte offset" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6742;entryX=0.5;entryY=0.6742;" edge="1" parent="1" source="sender" target="receiver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="ZRINIT: file accepted; ready for another file" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7303;entryX=0.5;entryY=0.7303;" edge="1" parent="1" source="receiver" target="sender">
