  <diagram name="curl troubleshooting">
    <mxGraphModel dx="1420" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="curl" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f2329;strokeColor=#1f2329;fontColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="3" value="No response?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Too slow?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5" value="DNS or routing?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="6" value="TLS or protocol?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Proxy involved?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="860" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8" value="HTTP or API?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1190" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Feature unavailable?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1470" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="10" value="Check headers&#xa;curl -I URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="20" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Inspect connection&#xa;curl -v URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="100" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Stop a hang&#xa;curl --connect-timeout 3 --max-time 10 URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="180" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="13" value="Measure total time&#xa;curl -sS -o /dev/null -w '%{time_total}' URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4eff8;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="260" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Split DNS / connect / TLS / TTFB&#xa;use --write-out timing variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4eff8;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="340" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="15" value="Test one backend&#xa;curl --resolve HOST:PORT:IP URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="420" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Compare address families&#xa;curl -4 URL / curl -6 URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf6ec;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="500" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="17" value="Inspect TLS and ALPN&#xa;curl -v URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="580" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Test a private CA&#xa;curl --cacert CA.pem URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="660" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Compare HTTP/1.1&#xa;curl --http1.1 URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="740" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="20" value="Test through proxy&#xa;curl -x PROXY URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e8;strokeColor=#d79b00;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="820" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="21" value="Bypass all proxies&#xa;curl --noproxy '*' URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e8;strokeColor=#d79b00;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="900" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="22" value="Print status only&#xa;curl -sS -o /dev/null -w '%{response_code}' URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcebea;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="980" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Fail on HTTP errors&#xa;curl --fail-with-body URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcebea;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="1060" width="620" height="60" as="geometry" />
